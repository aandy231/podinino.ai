# Podinino Configuration Example

# Server
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO
ENV=production

# Database (Pure MongoDB)
MONGODB_URL=mongodb://mongodb:27017
MONGODB_DB_NAME=podinino_db

# GitHub OAuth credentials (Required for login & repo access)
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
GITHUB_REDIRECT_URI=https://podinino.example.com/auth/callback

# Kubernetes & Sandbox Provisioning
POD_NAMESPACE=default
BASE_DOMAIN=sandbox.example.com
MAX_WORKSPACES_PER_USER=5
SANDBOX_IMAGE=ghcr.io/podinino/claude-code-sandbox:latest
ENCRYPTION_KEY=replace-with-a-32-byte-secret-encryption-key!
